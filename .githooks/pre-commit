#!/bin/sh
# denext pre-commit hook — fast formatting + lint auto-fix before a commit lands.
#
# Runs `deno task check:fix` (deno fmt, deno lint --fix, then a report-only
# deno lint). It is intentionally FAST: formatting and linting only, no tests —
# the full suite stays in CI. Enable it once per clone with:
#
#     deno task hooks:install
#
# The final `deno lint` reports the rules that have no auto-fix (the denext/*
# correctness rules); if it fails the commit is aborted so the remaining issues
# are addressed by hand. See CONTRIBUTING.md for how to fix each by hand.
set -e

# Resolve deno robustly: git runs hooks under /bin/sh, whose PATH often lacks
# ~/.deno/bin (and `deno` may be a shell alias that doesn't apply here).
if command -v deno >/dev/null 2>&1; then
  DENO=deno
elif [ -x "$HOME/.deno/bin/deno" ]; then
  DENO="$HOME/.deno/bin/deno"
else
  echo "pre-commit: deno not found. Install it (https://deno.com) or add ~/.deno/bin to PATH." >&2
  exit 1
fi

# `deno task` puts this deno on PATH for the task's own `deno fmt`/`deno lint` calls.
"$DENO" task check:fix

# Re-stage the formatted content of files that were ALREADY staged for this commit.
# `deno fmt` / `deno lint --fix` above edit the working tree but not the index, so without
# this the commit would capture the PRE-format content and the files show as "modified"
# again immediately after committing (and CI's `deno fmt --check` fails on the commit).
# Only re-add files already staged — never unstaged work. `-z`/`xargs -0` handle spaces.
if git diff --cached --name-only --diff-filter=ACM | grep -q .; then
  git diff --cached --name-only --diff-filter=ACM -z | xargs -0 git add --
fi

# `check:fix` also refreshed the test-count badge (`deno task badge:tests`); stage it when
# the count moved, so the committed badge always matches the committed tests (CI runs
# `badge:tests --check`).
if ! git diff --quiet -- .github/badges/tests.json; then
  git add -- .github/badges/tests.json
fi

# `check:fix` also regenerated the CLI's verb table (`deno task gen:command-table`): the
# entrypoint parses from it, so a flag added to a verb — or pulled in by a rebase — that the
# committed table lacks is an "unknown flag" on development. Stage it when it moved (the drift
# test in tests/cli-startup-graph.test.ts stays the backstop).
for generated in src/cli/command-table.generated.ts src/cli/lazy-modules.generated.ts; do
  if ! git diff --quiet -- "$generated"; then
    git add -- "$generated"
  fi
done

# The packed native templates (src/build/native-templates.packed.ts) are generated from the
# readable sources under src/build/native-templates/. When the commit stages a source, repack
# and stage it (tests/native-templates-packed.test.ts stays the backstop).
if git diff --cached --name-only --diff-filter=ACMDR | grep -q '^src/build/native-templates/'; then
  "$DENO" task gen:native-templates
  git add -- src/build/native-templates.packed.ts
fi

# The generated docs corpus (packages/docs-corpus/mod.ts, `@denext/docs-corpus`) and llms files (site/public/llms*.txt) are
# derived from the docs pages, the root guides, the example READMEs and their generators. Parallel
# docs edits each leave them stale against the combined tip (CI: tests/mcp-docs-corpus.test.ts,
# tests/docs-generated.test.ts). When the commit stages any input, regenerate both and stage them.
# Only then, so every other commit stays fast.
if git diff --cached --name-only --diff-filter=ACMDR \
  | grep -Eq '^(site/app/docs/|AGENTS\.md$|[^/]+\.md$|examples/[^/]+/README\.md$|site/lib/examples\.ts$|site/lib/markdown\.ts$|site/components/ui\.tsx$|scripts/(gen-docs-corpus|gen-llms-txt)\.ts$|scripts/lib/docs-corpus\.ts$|src/mcp/(guide|tools)\.ts$)'; then
  "$DENO" task docs:corpus
  "$DENO" task docs:llms
  git add -- packages/docs-corpus/mod.ts site/public/llms.txt site/public/llms-full.txt
  # A changed corpus whose version was already released got the next patch version, and the
  # plugin catalog that lists the package was regenerated with it (scripts/gen-docs-corpus.ts).
  if ! git diff --quiet -- packages/docs-corpus/deno.json; then
    git add -- packages/docs-corpus/deno.json src/plugin/catalog.json
  fi
fi

# Fallow code-intelligence gate. `fallow audit` scopes dead-code + complexity +
# duplication to the changeset and exits 1 on a `fail` verdict (0 otherwise), so
# `set -e` aborts the commit on failure. Fallow is REQUIRED — resolve it like
# deno above, since /bin/sh's PATH often lacks the npm/cargo global bin dir.
if command -v fallow >/dev/null 2>&1; then
  FALLOW=fallow
elif command -v npx >/dev/null 2>&1 && npx --no-install fallow --version >/dev/null 2>&1; then
  FALLOW="npx --no-install fallow"
else
  echo "pre-commit: fallow not found. Install it: npm i -g fallow (or cargo install fallow-cli)." >&2
  echo "pre-commit: see CONTRIBUTING.md > The checks (Fallow gate)." >&2
  exit 1
fi

# Human-formatted output so findings are readable in the terminal on failure.
# --no-css drops styling analytics: they are advisory-only (never gate the
# verdict) and mostly flag vendored fixtures / standalone example stylesheets.
# Inspect them on demand with `fallow health --css`.
# Measured coverage, when present: `deno task coverage:fallow` writes an Istanbul map
# from the unit suite so fallow's CRAP score uses real per-function coverage instead
# of its import-graph estimate (which under-scores framework internals that tests
# reach only transitively, e.g. the fiber reconciler). Fallow also auto-discovers this
# path; passing it explicitly keeps the gate's input visible. Optional: without the
# file the audit runs exactly as before. Never configure this in fallow.toml — a
# missing file there is a hard error, which would silently skip the gate.
COV=""
if [ -f coverage/coverage-final.json ]; then
  COV="--coverage coverage/coverage-final.json"
else
  echo "pre-commit: no coverage/coverage-final.json — fallow will ESTIMATE coverage for CRAP." >&2
  echo "pre-commit: run 'deno task coverage:fallow' first if the gate blocks on a CRAP finding." >&2
fi
# Fallow keeps a base-tree cache per audited base commit in the temp dir and never removes it
# (about 120 MB each; hundreds pile up across commits and worktrees). Drop the ones idle for
# 30 minutes or more (disk is tight with parallel agents) — a running audit touches its own, so it is never removed under it.
find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'fallow-audit-base-cache-*' -mmin +30 \
  -exec rm -rf {} + 2>/dev/null || true

# A detached worktree (how parallel work is done here) has no upstream, so fallow's default
# base falls back to origin/main and every commit since the last release counts as new. All
# work lands on development: audit against it unless a base is already pinned.
if [ -z "${FALLOW_AUDIT_BASE:-}" ] && ! git rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1 \
  && git rev-parse --verify -q origin/development >/dev/null; then
  export FALLOW_AUDIT_BASE=origin/development
fi

$FALLOW audit --quiet --explain --gate-marker git --no-css $COV
