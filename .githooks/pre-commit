#!/bin/sh
# denext pre-commit hook — fast formatting + lint auto-fix before a commit lands.
#
# Runs `deno task check:fix` (deno fmt, deno lint --fix, then a report-only
# deno lint). It is intentionally FAST: formatting and linting only, no tests —
# the full suite stays in CI. Enable it once per clone with:
#
#     deno task hooks:install
#
# The final `deno lint` reports the rules that have no auto-fix (the denext/*
# correctness rules); if it fails the commit is aborted so the remaining issues
# are addressed by hand. See CONTRIBUTING.md for how to fix each by hand.
set -e

# Resolve deno robustly: git runs hooks under /bin/sh, whose PATH often lacks
# ~/.deno/bin (and `deno` may be a shell alias that doesn't apply here).
if command -v deno >/dev/null 2>&1; then
  DENO=deno
elif [ -x "$HOME/.deno/bin/deno" ]; then
  DENO="$HOME/.deno/bin/deno"
else
  echo "pre-commit: deno not found. Install it (https://deno.com) or add ~/.deno/bin to PATH." >&2
  exit 1
fi

# `deno task` puts this deno on PATH for the task's own `deno fmt`/`deno lint` calls.
"$DENO" task check:fix

# Re-stage the formatted content of files that were ALREADY staged for this commit.
# `deno fmt` / `deno lint --fix` above edit the working tree but not the index, so without
# this the commit would capture the PRE-format content and the files show as "modified"
# again immediately after committing (and CI's `deno fmt --check` fails on the commit).
# Only re-add files already staged — never unstaged work. `-z`/`xargs -0` handle spaces.
if git diff --cached --name-only --diff-filter=ACM | grep -q .; then
  git diff --cached --name-only --diff-filter=ACM -z | xargs -0 git add --
fi

# Fallow code-intelligence gate. `fallow audit` scopes dead-code + complexity +
# duplication to the changeset and exits 1 on a `fail` verdict (0 otherwise), so
# `set -e` aborts the commit on failure. Fallow is REQUIRED — resolve it like
# deno above, since /bin/sh's PATH often lacks the npm/cargo global bin dir.
if command -v fallow >/dev/null 2>&1; then
  FALLOW=fallow
elif command -v npx >/dev/null 2>&1 && npx --no-install fallow --version >/dev/null 2>&1; then
  FALLOW="npx --no-install fallow"
else
  echo "pre-commit: fallow not found. Install it: npm i -g fallow (or cargo install fallow-cli)." >&2
  echo "pre-commit: see CONTRIBUTING.md > The checks (Fallow gate)." >&2
  exit 1
fi

# Human-formatted output so findings are readable in the terminal on failure.
$FALLOW audit --quiet --explain --gate-marker git
