{
  "name": "@denext/denext",
  "version": "2.0.0-rc.4",
  "license": "MIT",
  "workspace": [
    "./packages/photon",
    "./packages/avif",
    "./packages/og",
    "./packages/pages-router",
    "./packages/htmx",
    "./packages/effect"
  ],
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts",
    "./cli/command": "./src/cli/command.ts",
    "./plugin-kit": "./src/plugin/kit.ts",
    "./jsx-runtime": "./src/jsx/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx/jsx-runtime.ts",
    "./server": "./src/server/mod.ts",
    "./client": "./src/client/mod.ts",
    "./devtools": "./src/devtools.ts",
    "./desktop": "./src/build/desktop.ts",
    "./live": "./src/live.ts",
    "./lazy": "./src/lazy.ts",
    "./compiler-runtime": "./src/runtime/compiler-runtime.ts",
    "./lint-plugin": "./src/lint/denext-plugin.ts",
    "./react": "./src/compat/react.ts",
    "./react-dom": "./src/compat/react-dom.ts",
    "./react-dom/client": "./src/compat/react-dom-client.ts",
    "./react-dom/server": "./src/compat/react-dom-server.ts",
    "./react-dom/server.browser": "./src/compat/react-dom-server.ts",
    "./react-dom/server.edge": "./src/compat/react-dom-server.ts",
    "./react-dom/test-utils": "./src/compat/test-utils.ts",
    "./react/jsx-runtime": "./src/jsx/jsx-runtime.ts",
    "./react/jsx-dev-runtime": "./src/jsx/jsx-runtime.ts",
    "./react-is": "./src/compat/react-is.ts",
    "./slot": "./src/compat/slot.ts",
    "./compose-refs": "./src/compat/refs.ts",
    "./better-sqlite3": "./src/compat/better-sqlite3.ts",
    "./server-only": "./src/compat/server-only.ts",
    "./client-only": "./src/compat/client-only.ts",
    "./empty": "./src/compat/empty.ts",
    "./next-intl": "./src/compat/next-intl/index.ts",
    "./next-intl/server": "./src/compat/next-intl/server.ts",
    "./next-intl/navigation": "./src/compat/next-intl/navigation.ts",
    "./next-intl/middleware": "./src/compat/next-intl/middleware.ts",
    "./next-intl/routing": "./src/compat/next-intl/routing.ts",
    "./next": "./src/compat/next/index.ts",
    "./next/font/local": "./src/compat/next/font/local.ts",
    "./next/font/google": "./src/compat/next/font/google.ts",
    "./next/head": "./src/compat/next/head.ts",
    "./next/link": "./src/compat/next/link.ts",
    "./next/form": "./src/compat/next/form.ts",
    "./next/image": "./src/compat/next/image.ts",
    "./next/script": "./src/compat/next/script.ts",
    "./next/dynamic": "./src/compat/next/dynamic.ts",
    "./next/navigation": "./src/compat/next/navigation.ts",
    "./next/headers": "./src/compat/next/headers.ts",
    "./next/cache": "./src/compat/next/cache.ts",
    "./next/og": "./src/compat/next/og.ts",
    "./next/server": "./src/compat/next/server.ts",
    "./build/next-compat": "./src/build/next-compat-build.ts",
    "./build/next-mdx": "./src/build/next-mdx-recover.ts",
    "./bundle": "./src/build/plugin-bundle.ts",
    "./build/css": "./src/build/plugin-css.ts",
    "./testing": "./src/testing/mod.ts"
  },
  "tasks": {
    "dev": "deno run -A cli.ts dev",
    "start": "deno run -A cli.ts start",
    "build": "deno run -A cli.ts build",
    "example:next-compat": "deno run -A --config deno.json examples/next-compat/serve.ts",
    "example:next-compat-recharts": "deno run -A --config deno.json examples/next-compat-recharts/serve.ts",
    "example:transitions": "deno run -A --config deno.json examples/transitions/serve.ts",
    "example:concurrency": "deno run -A --config deno.json examples/concurrency/serve.ts",
    "example:animation": "deno run -A --config deno.json examples/animation/serve.ts",
    "example:tailwind": "cd examples/tailwind && deno task dev",
    "example:game": "deno run -A --config deno.json examples/game/serve.ts",
    "docs:api": "deno run -A scripts/gen-api-reference.ts",
    "parity:refresh": "deno run -A scripts/parity/refresh.ts",
    "parity:drift": "deno run -A scripts/parity/refresh.ts --latest",
    "parity:gaps": "deno run -A scripts/parity/write-known-gaps.ts",
    "docs:build": "deno task docs:api && cd apps/web && deno task export",
    "compile": "deno compile -A --output denext cli.ts",
    "bench": "deno run -A --config deno.json bench/run.ts",
    "bench:load": "deno run -A --unstable-kv --config deno.json bench/load/run.ts",
    "bench:pages": "deno run -A --v8-flags=--expose-gc --config deno.json bench/pages/run.ts",
    "test": "deno test -A --unstable-kv --parallel --ignore=tests/e2e/",
    "test:unit": "deno test -A --unstable-kv --parallel --ignore=tests/e2e/,tests/integration/",
    "test:integration": "deno test -A --unstable-kv --parallel tests/integration/",
    "test:e2e": "deno test -A --unstable-kv tests/e2e/",
    "test:next-compat": "deno test -A --unstable-kv tests/e2e/next-compat-*.test.ts",
    "test:coverage": "rm -rf coverage && deno test -A --unstable-kv --parallel --ignore=tests/e2e/ --coverage=coverage && deno coverage coverage --include=/src/ --threshold=80",
    "badge:tests": "deno run --allow-read --allow-write scripts/badge-tests.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check:fix": "deno fmt && deno lint --fix && deno lint",
    "hooks:install": "git config core.hooksPath .githooks",
    "check": "deno fmt --check && deno lint && deno test -A --unstable-kv --parallel --ignore=tests/e2e/",
    "doc-lint": "deno doc --lint mod.ts cli.ts src/cli/command.ts src/plugin/kit.ts src/jsx/jsx-runtime.ts src/server/mod.ts src/client/mod.ts src/devtools.ts src/live.ts src/lazy.ts src/runtime/compiler-runtime.ts src/lint/denext-plugin.ts src/compat/react.ts src/compat/react-dom.ts src/compat/react-dom-client.ts src/compat/react-dom-server.ts src/compat/test-utils.ts src/compat/react-dom-preload.ts src/compat/react-is.ts src/compat/class-component.ts src/compat/class-detect.ts src/compat/slot.ts src/compat/refs.ts src/compat/better-sqlite3.ts src/runtime/profiler.ts src/build/next-compat-build.ts src/build/plugin-bundle.ts src/build/plugin-css.ts src/plugin/mod.ts src/testing/mod.ts src/compat/next/link.ts src/compat/next/form.ts src/compat/next/image.ts src/compat/next/script.ts src/compat/next/dynamic.ts src/compat/next/navigation.ts src/compat/next/headers.ts src/compat/next/cache.ts src/compat/next/og.ts src/compat/next/server.ts src/compat/next/cookies.ts src/compat/next/request.ts src/compat/next/font/local.ts src/compat/next/font/google.ts src/compat/next/font/registry.ts src/compat/next-intl/index.ts src/compat/next-intl/server.ts src/compat/next-intl/navigation.ts src/compat/next-intl/middleware.ts src/compat/next-intl/routing.ts src/compat/next-intl/context.ts src/compat/next-intl/icu.ts src/compat/next-intl/rich.ts",
    "release-check": "deno task check && deno task doc-lint && deno publish --dry-run",
    "bump": "deno run --allow-read --allow-write scripts/bump-version.ts",
    "release": "deno run -A scripts/release.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "denext",
    "lib": [
      "deno.window",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ],
    "strict": true
  },
  "imports": {
    "denext/jsx-runtime": "./src/jsx/jsx-runtime.ts",
    "denext/jsx-dev-runtime": "./src/jsx/jsx-runtime.ts",
    "denext": "./mod.ts",
    "denext/server": "./src/server/mod.ts",
    "denext/client": "./src/client/mod.ts",
    "denext/build/next-mdx": "./src/build/next-mdx-recover.ts",
    "denext/devtools": "./src/devtools.ts",
    "denext/plugin-kit": "./src/plugin/kit.ts",
    "denext/live": "./src/live.ts",
    "denext/lazy": "./src/lazy.ts",
    "denext/testing": "./src/testing/mod.ts",
    "denext/compiler-runtime": "./src/runtime/compiler-runtime.ts",
    "next/font/google": "./src/compat/next/font/google.ts",
    "next/font/local": "./src/compat/next/font/local.ts",
    "@std/http": "jsr:@std/http@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/media-types": "jsr:@std/media-types@^1.0.0",
    "@std/async": "jsr:@std/async@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.0",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "effect": "npm:effect@^3.22.0",
    "lightningcss-wasm": "npm:lightningcss-wasm@^1.33.0",
    "sass": "npm:sass@^1.80.0",
    "@mdx-js/mdx": "npm:@mdx-js/mdx@^3",
    "@swc/wasm-web": "npm:@swc/wasm-web@^1.13.5",
    "@astral/astral": "jsr:@astral/astral@^0.5.3",
    "esbuild": "npm:esbuild@^0.24.0",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.0",
    "ws": "npm:ws@^8"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "exclude": [
      ".denext/",
      "examples/*/.denext/",
      "apps/*/.denext/",
      "apps/*/out/",
      "dist/",
      "docs/",
      "packages/*/lib/",
      "packages/*/vendor/",
      "bench/node_modules/",
      "bench/fixtures/",
      "bench/results/",
      "bench/REPORT.md"
    ]
  },
  "lint": {
    "plugins": ["./src/lint/denext-plugin.ts"],
    "exclude": [
      ".denext/",
      "examples/*/.denext/",
      "apps/*/.denext/",
      "apps/*/out/",
      "dist/",
      "docs/",
      "packages/*/lib/",
      "packages/*/vendor/",
      "bench/node_modules/",
      "bench/fixtures/",
      "bench/results/"
    ]
  },
  "publish": {
    "exclude": [
      "tests/",
      "examples/",
      "apps/",
      "bench/",
      "assets/",
      ".denext/",
      "dist/",
      "docs/",
      "denext",
      "denext.exe",
      "CHANGELOG.md",
      "CVE-DEFENSE-GUIDE.md",
      "ROADMAP.md"
    ]
  }
}
