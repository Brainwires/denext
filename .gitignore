# Deno
.deno/
deno.lock.bak

# npm packages (denext resolves npm: deps from Deno's cache; a root node_modules is a
# stray artifact, e.g. materialized when `deno check` resolves a `npm:` import)
node_modules/

# Build output (any directory)
.denext/
out/
/dist/

# Compiled binary (produced by `deno task compile`)
/denext
/denext.exe

# Editor / OS
.DS_Store
.idea/
# Ignore personal editor state, but ship the shared Deno LSP config so a fresh clone
# resolves `denext`/the import map out of the box (see settings.json / extensions.json).
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.claude/
*.log

# Scratch
/tmp/

# Generated API docs (deno doc --html)
/docs/

# Coverage profiles (deno task test:coverage)
coverage/
