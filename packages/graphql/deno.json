{
  "name": "@denext/graphql",
  "version": "0.2.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./subscriptions": "./subscriptions.ts",
    "./command": "./command.ts"
  },
  "imports": {
    "@denext/denext": "jsr:@denext/denext@^2.5.0-rc.1",
    "@std/path": "jsr:@std/path@^1.0.0",
    "graphql": "npm:graphql@^16.9.0",
    "graphql-yoga": "npm:graphql-yoga@^5.10.0"
  },
  "denext": {
    "catalog": {
      "kind": "plugin",
      "factory": "graphql",
      "optionsType": "GraphqlOptions",
      "verb": "graphql",
      "configKeys": [
        "schema",
        "path",
        "graphiql",
        "introspection",
        "maxBodyBytes",
        "maxDepth",
        "maxCost",
        "costOptions",
        "requireSameOrigin",
        "allowedOrigins",
        "context",
        "yoga",
        "outFile"
      ]
    }
  },
  "publish": {
    "include": [
      "mod.ts",
      "subscriptions.ts",
      "command.ts",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "deno.json"
    ]
  }
}
