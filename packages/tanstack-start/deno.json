{
  "name": "@denext/tanstack-start",
  "version": "0.2.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts"
  },
  "imports": {
    "@denext/denext": "jsr:@denext/denext@^4.3.1",
    "@denext/denext/plugin-kit": "jsr:@denext/denext@^4.3.1/plugin-kit",
    "@std/path": "jsr:@std/path@^1.0.0"
  },
  "denext": {
    "catalog": {
      "kind": "plugin",
      "factory": "tanstackStart",
      "optionsType": "TanStackStartOptions",
      "configKeys": [
        "srcDirectory",
        "router",
        "generateRouteTree",
        "maxBodyBytes",
        "allowedOrigins",
        "importProtection",
        "prerender",
        "pages",
        "sitemap",
        "spa"
      ]
    }
  },
  "publish": {
    "include": [
      "mod.ts",
      "src",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "deno.json"
    ]
  }
}
