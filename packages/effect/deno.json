{
  "name": "@denext/effect",
  "version": "0.2.0",
  "exports": {
    ".": "./mod.ts"
  },
  "imports": {
    "@denext/denext": "jsr:@denext/denext@^4.11.4",
    "@denext/denext/server": "jsr:@denext/denext@^4.11.4/server",
    "@denext/denext/plugin-kit": "jsr:@denext/denext@^4.11.4/plugin-kit",
    "effect": "npm:effect@^3.22.0"
  },
  "denext": {
    "catalog": {
      "kind": "plugin",
      "factory": "effect",
      "optionsType": "EffectPluginOptions",
      "configKeys": ["layer"]
    }
  },
  "publish": {
    "include": [
      "mod.ts",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "deno.json"
    ]
  }
}
