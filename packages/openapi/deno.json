{
  "name": "@denext/openapi",
  "version": "0.7.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./spec": "./spec.ts",
    "./command": "./command.ts",
    "./types": "./types.ts",
    "./clients": "./clients/mod.ts"
  },
  "imports": {
    "@denext/denext": "jsr:@denext/denext@^4.11.3",
    "@std/path": "jsr:@std/path@^1.0.0"
  },
  "denext": {
    "catalog": {
      "kind": "plugin",
      "factory": "openapi",
      "optionsType": "OpenApiOptions",
      "verb": "openapi",
      "configKeys": [
        "path",
        "docs",
        "ui",
        "cdn",
        "info",
        "servers",
        "toJsonSchema",
        "include",
        "tags",
        "securitySchemes",
        "security",
        "expose",
        "authorize",
        "outFile",
        "sources"
      ]
    }
  },
  "publish": {
    "include": [
      "mod.ts",
      "spec.ts",
      "json-schema.ts",
      "docs-ui.ts",
      "command.ts",
      "types.ts",
      "clients/",
      "swagger-ui.ts",
      "vendored.ts",
      "scalar-ui.ts",
      "vendor/swagger-ui/swagger-ui-bundle.js",
      "vendor/swagger-ui/swagger-ui.css",
      "vendor/swagger-ui/LICENSE",
      "vendor/swagger-ui/NOTICE",
      "vendor/swagger-ui/swagger-ui-bundle.js.LICENSE.txt",
      "vendor/scalar/standalone.js",
      "vendor/scalar/LICENSE",
      "vendor/scalar/NOTICE",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "deno.json"
    ]
  }
}
