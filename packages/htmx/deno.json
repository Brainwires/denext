{
  "name": "@denext/htmx",
  "version": "2.0.11",
  "exports": {
    ".": "./mod.ts",
    "./types": "./types.ts",
    "./command": "./command.ts"
  },
  "imports": {
    "@denext/denext": "jsr:@denext/denext@^2.5.0-rc.5",
    "@std/path": "jsr:@std/path@^1.0.0"
  },
  "denext": {
    "catalog": {
      "kind": "plugin",
      "factory": "htmx",
      "verb": "htmx",
      "optionsType": "HtmxOptions",
      "configKeys": ["path"]
    }
  },
  "publish": {
    "include": [
      "mod.ts",
      "types.ts",
      "command.ts",
      "constants.ts",
      "vendor",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "deno.json"
    ]
  }
}
