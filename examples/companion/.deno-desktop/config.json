{
  "desktop": {
    "app": {
      "identifier": "dev.denext.loopy",
      "name": "Loopy",
      "icons": {
        "macos": "./icons/macos.png",
        "linux": "./icons/linux.png",
        "windows": "./icons/windows.ico"
      },
      "activationPolicy": "accessory"
    },
    "window": {
      "width": 325,
      "height": 375,
      "title": "Loopy",
      "resizable": false,
      "frameless": true,
      "transparent": true,
      "focusable": false,
      "alwaysOnTop": "status",
      "visibleOnAllWorkspaces": true,
      "skipTaskbar": true,
      "overlay": true
    },
    "backdrop": "none",
    "backend": {
      "linux": "cef"
    },
    "tray": {
      "icon": "/tray.png",
      "tooltip": "Loopy",
      "menu": [
        {
          "id": "show",
          "label": "Show Loopy"
        },
        {
          "id": "hide",
          "label": "Hide Loopy"
        },
        {
          "separator": true
        },
        {
          "id": "quit",
          "label": "Quit Loopy"
        }
      ]
    },
    "extraPermissions": {
      "write": [
        "$APPDATA"
      ],
      "net": [
        "api.openai.com"
      ],
      "run": [
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "/Applications/Chromium.app/Contents/MacOS/Chromium",
        "/usr/bin/google-chrome",
        "/usr/bin/google-chrome-stable",
        "/usr/bin/chromium",
        "/usr/bin/chromium-browser",
        "/snap/bin/chromium",
        "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
        "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe"
      ]
    },
    "installers": {
      "macos": [],
      "linux": [],
      "windows": []
    },
    "capabilities": {
      "secureStore": true,
      "globalShortcuts": true,
      "shell": {
        "openExternal": [
          "https:",
          "http:"
        ]
      },
      "microphone": {
        "usageDescription": "Loopy listens to you only while you talk to it: hold Space, click Loopy or press its shortcut."
      }
    }
  }
}
