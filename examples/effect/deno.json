{
  "//": "generated by `denext migrate` — safe to edit; re-running may overwrite",
  "tasks": {
    "dev": "deno run -A jsr:@denext/denext/cli dev .",
    "build": "deno run -A jsr:@denext/denext/cli build .",
    "export": "deno run -A jsr:@denext/denext/cli export .",
    "start": "deno run -A jsr:@denext/denext/cli start ."
  },
  "nodeModulesDir": "auto",
  "unstable": [
    "sloppy-imports"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ],
    "strict": true,
    "skipLibCheck": true
  },
  "imports": {
    "denext": "jsr:@denext/denext@^2.0.0-rc.5",
    "denext/jsx-runtime": "jsr:@denext/denext@^2.0.0-rc.5/jsx-runtime",
    "denext/server": "jsr:@denext/denext@^2.0.0-rc.5/server",
    "denext/client": "jsr:@denext/denext@^2.0.0-rc.5/client",
    "react": "jsr:@denext/denext@^2.0.0-rc.5/react",
    "react-dom": "jsr:@denext/denext@^2.0.0-rc.5/react-dom",
    "react-dom/client": "jsr:@denext/denext@^2.0.0-rc.5/react-dom/client",
    "react-dom/server": "jsr:@denext/denext@^2.0.0-rc.5/react-dom/server",
    "react/jsx-runtime": "jsr:@denext/denext@^2.0.0-rc.5/react/jsx-runtime",
    "react/jsx-dev-runtime": "jsr:@denext/denext@^2.0.0-rc.5/react/jsx-dev-runtime",
    "react-is": "jsr:@denext/denext@^2.0.0-rc.5/react-is",
    "next": "jsr:@denext/denext@^2.0.0-rc.5/next",
    "next-intl": "jsr:@denext/denext@^2.0.0-rc.5/next-intl",
    "better-sqlite3": "jsr:@denext/denext@^2.0.0-rc.5/better-sqlite3",
    "next/": "jsr:@denext/denext@^2.0.0-rc.5/next/",
    "next-intl/": "jsr:@denext/denext@^2.0.0-rc.5/next-intl/",
    "@/": "./",
    "effect": "npm:effect@3.22.0",
    "@denext/effect": "jsr:@denext/effect@^0.1.0"
  }
}
