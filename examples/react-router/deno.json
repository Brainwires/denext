  "imports": {
    "denext": "../../mod.ts",
    "denext/jsx-runtime": "../../src/jsx/jsx-runtime.ts",
    "denext/jsx-dev-runtime": "../../src/jsx/jsx-runtime.ts",
    "denext/server": "../../src/server/mod.ts",
    "denext/client": "../../src/client/mod.ts",
    "denext/live": "../../src/live.ts",
    "denext/remix": "../../src/compat/remix/mod.ts",
    "denext/remix/server": "../../src/compat/remix/server.ts",
    "@denext/denext": "../../mod.ts",
    "@denext/denext/server": "../../src/server/mod.ts",
    "@denext/denext/plugin-kit": "../../src/plugin/kit.ts",
    "@denext/denext/cli/command": "../../src/cli/command.ts",
    "@denext/denext/remix": "../../src/compat/remix/mod.ts",
    "@denext/denext/remix/server": "../../src/compat/remix/server.ts",
    "@denext/react-router": "../../packages/react-router/mod.ts",
    "@denext/react-router/routes": "../../packages/react-router/routes.ts",
    "@denext/react-router/dom": "../../packages/react-router/dom.ts",
    "react-router": "../../src/compat/remix/mod.ts",
    "react-router-dom": "../../src/compat/remix/mod.ts",
    "react-router/dom": "../../packages/react-router/dom.ts",
    "@react-router/dev/routes": "../../packages/react-router/routes.ts",
    "@react-router/node": "../../src/compat/remix/server.ts",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0"
  },
  "lint": {
    "plugins": ["../../src/lint/denext-plugin.ts"]
  }
