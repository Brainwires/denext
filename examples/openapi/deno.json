{
  "tasks": {
    "dev": "deno run -A ../../cli.ts dev .",
    "build": "deno run -A ../../cli.ts build .",
    "start": "deno run -A ../../cli.ts start .",
    "openapi:types": "deno run -A ../../cli.ts openapi types --out lib/api-types.gen.ts"
  },
  "nodeModulesDir": "none",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "denext",
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ]
  },
  "imports": {
    "denext": "../../mod.ts",
    "denext/jsx-runtime": "../../src/jsx/jsx-runtime.ts",
    "denext/jsx-dev-runtime": "../../src/jsx/jsx-runtime.ts",
    "denext/server": "../../src/server/mod.ts",
    "denext/client": "../../src/client/mod.ts",
    "denext/live": "../../src/live.ts",
    "@denext/denext": "../../mod.ts",
    "@denext/denext/server": "../../src/server/mod.ts",
    "@denext/denext/plugin-kit": "../../src/plugin/kit.ts",
    "@denext/denext/cli/command": "../../src/cli/command.ts",
    "@denext/openapi": "../../packages/openapi/mod.ts",
    "@std/path": "jsr:@std/path@^1.0.0",
    "zod": "npm:zod@^4",
    "@denext/auth": "../../packages/auth/mod.ts",
    "@denext/denext/auth-kit": "../../src/server/auth-kit.ts",
    "@denext/denext/auth-kit/client": "../../src/client/auth-kit.ts",
    "@denext/denext/client": "../../src/client/mod.ts",
    "@denext/denext/jsx-runtime": "../../src/jsx/jsx-runtime.ts",
    "@denext/denext/next/server": "../../src/compat/next/server.ts",
    "@std/encoding": "jsr:@std/encoding@^1.0.0"
  },
  "lint": {
    "plugins": [
      "../../src/lint/denext-plugin.ts"
    ]
  }
}
