.denext/
# The desktop sync writes these; config.json (the entry's config) is committed so desktop.ts
# type-checks and `denext desktop run` leaves the folder as it found it.
.deno-desktop/*
!.deno-desktop/config.json
out/
dist/
node_modules/
e2e/.run/
# Packaging scripts: written from the CURRENT scaffold template by `deno task desktop:package`
# (`denext desktop package --regenerate-scripts`), never vendored.
scripts/
# `deno desktop` output when run without --output
*.app/
*.dylib.tmp-*
ios/
android/
