# Copy to .env.local (git-ignored) and paste your Clerk application's keys
# (Clerk dashboard → Configure → API keys). Never commit real keys.
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY  pk_test_… (reaches the page)
#   CLERK_SECRET_KEY                   sk_test_… (server only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: the JWT public key (API keys page → "JWT public key", PEM) for networkless session
# verification. Without it the server fetches the instance's JWKS with the secret key.
CLERK_JWT_KEY=

# Optional: this machine's tailnet name, so phones and other computers can load the dev
# server (README → Tailscale), e.g. mac.tail1234.ts.net. Added to allowedDevOrigins.
DENEXT_CLERK_DEV_HOST=
