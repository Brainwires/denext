{
  "tasks": {
    "dev": "deno run -A --node-modules-dir=none ../../cli.ts dev .",
    "build": "deno run -A --node-modules-dir=none ../../cli.ts build .",
    "export": "deno run -A --node-modules-dir=none ../../cli.ts export .",
    "cap:sync": "deno task export && node_modules/.bin/cap sync",
    "ios": "xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -destination generic/platform=iOS -jobs 2 -allowProvisioningUpdates DEVELOPMENT_TEAM=$DENEXT_IOS_TEAM build",
    "ios:check": "xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -destination generic/platform=iOS -jobs 2 CODE_SIGNING_ALLOWED=NO build",
