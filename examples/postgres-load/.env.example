# Copy to .env (the tasks load it with --env-file=.env).
# Matches docker-compose.yml; point it at any Postgres you like.
DATABASE_URL=postgres://denext:denext@localhost:5432/denext

# Connection pool size. The load test is most interesting when your concurrency
# is well ABOVE this — that is when the pool has to queue requests.
POOL_SIZE=10
