# Copy to fastlane/.env and fill in. fastlane auto-loads fastlane/.env; the real
# .env is gitignored (secrets). Every value here is optional until you run the
# lane that needs it — the lanes fail with a clear message when a required one is
# missing.

# ── App identity (defaults to capacitor.config.ts) ───────────────────────────
APP_ID=com.example.denext-native
ANDROID_PACKAGE=com.example.denext-native

# ── iOS: App Store Connect API key ───────────────────────────────────────────
# Create it in App Store Connect:
#   Users and Access → Integrations → App Store Connect API → generate key
#   Role: App Manager (enough for TestFlight + builds; not full Admin)
# You get an Issuer ID (once, page top), a Key ID, and a one-time .p8 download.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Absolute path to the .p8 you downloaded (store it OUTSIDE the repo).
ASC_KEY_FILEPATH=/Users/you/.appstoreconnect/AuthKey_XXXXXXXXXX.p8

# Apple Developer Team id used to sign the archive (required by `ios beta`).
TEAM_ID=XXXXXXXXXX

# Which TestFlight external group to release to (created by `ios create_group`).
TESTFLIGHT_GROUP=External Testers

# Optional: only build a workspace instead of the SwiftPM .xcodeproj (CocoaPods).
# XCODE_WORKSPACE=ios/App/App.xcworkspace
# XCODE_SCHEME=App

# ── iOS: external Beta App Review metadata (all optional) ─────────────────────
# Provided steps are applied; omitted ones are skipped. A description is required
# by Apple for EXTERNAL testing, so set REVIEW_DESCRIPTION before `ios beta`/submit.
# REVIEW_DESCRIPTION=A denext + Capacitor example app.
# FASTLANE_FEEDBACK_EMAIL=you@example.com
# REVIEW_WHATS_NEW=What to try in this build.
# Demo account — only if the app is behind sign-in:
# REVIEW_DEMO_USER=
# REVIEW_DEMO_PASS=
# REVIEW_CONTACT_FIRST=
# REVIEW_CONTACT_LAST=
# REVIEW_CONTACT_PHONE=
# REVIEW_NOTES=

# ── Android: Google Play ─────────────────────────────────────────────────────
# Absolute path to the Play service-account JSON (Play Console → Setup → API
# access). Required by `android beta` / `android upload_only`.
# PLAY_JSON_KEY=/Users/you/.playconsole/denext-native-service-account.json
# Track to upload to (internal | alpha | beta | production).
PLAY_TRACK=internal
