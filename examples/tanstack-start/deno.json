{
  "//": "`workspace: []` makes this example its own Deno workspace root (see examples/tanstack-router).",
  "workspace": [],
  "nodeModulesDir": "manual",
  "tasks": {
    "install": "deno install",
    "dev": "deno run -A ../../cli.ts dev .",
    "build": "deno run -A ../../cli.ts build .",
    "start": "deno run -A ../../cli.ts start ."
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["deno.window", "dom", "dom.iterable", "dom.asynciterable"]
  },
  "imports": {
    "denext": "../../mod.ts",
    "denext/server": "../../src/server/mod.ts",
    "denext/client": "../../src/client/mod.ts",
    "@denext/denext": "../../mod.ts",
    "@denext/denext/server": "../../src/server/mod.ts",
    "@denext/denext/plugin-kit": "../../src/plugin/kit.ts",
    "@denext/denext/cli/command": "../../src/cli/command.ts",
    "@denext/tanstack-start": "../../packages/tanstack-start/mod.ts",
    "@std/path": "jsr:@std/path@^1.0.0",
    "react": "../../src/compat/react.ts",
    "react-dom": "../../src/compat/react-dom.ts",
    "react-dom/client": "../../src/compat/react-dom-client.ts",
    "react-dom/server": "../../src/compat/react-dom-server.ts",
    "react/jsx-runtime": "../../src/jsx/jsx-runtime.ts",
    "react/jsx-dev-runtime": "../../src/jsx/jsx-runtime.ts"
  },
  "fmt": { "exclude": ["src/routeTree.gen.ts"] },
  "lint": {
    "exclude": ["src/routeTree.gen.ts"],
    "plugins": ["../../src/lint/denext-plugin.ts"]
  }
}
