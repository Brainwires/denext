{
  "tasks": {
    "dev": "deno run -A ../../cli.ts dev .",
    "build": "deno run -A ../../cli.ts build .",
    "start": "deno run -A ../../cli.ts start .",
    "export": "deno run -A ../../cli.ts export .",
    "send": "deno run --allow-net --allow-env --allow-sys=networkInterfaces cli/send.ts",
    "desktop": "deno run -A ../../cli.ts desktop run .",
    "desktop:dev": "deno run -A ../../cli.ts desktop dev .",
    "mobile:dev": "deno run -A ../../cli.ts mobile dev . --lan",
    "probe": "deno run -A probe.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "denext",
    "lib": [
      "deno.window",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ]
  },
  "imports": {
    "denext": "../../mod.ts",
    "denext/jsx-runtime": "../../src/jsx/jsx-runtime.ts",
    "denext/jsx-dev-runtime": "../../src/jsx/jsx-runtime.ts",
    "denext/server": "../../src/server/mod.ts",
    "denext/client": "../../src/client/mod.ts",
    "denext/mobile": "../../src/mobile/mod.ts",
    "denext/desktop": "../../src/build/desktop.ts",
    "denext/desktop/window": "../../src/desktop/window.ts",
    "denext/testing": "../../src/testing/mod.ts",
    "@std/path": "jsr:@std/path@^1"
  },
  "lint": {
    "plugins": [
      "../../src/lint/denext-plugin.ts"
    ]
  },
  "desktop": {
    "app": {
      "name": "RTC viewer",
      "identifier": "dev.denext.rtc-viewer"
    }
  },
  "exclude": [
    "out/",
    ".denext/",
    "dist/",
    "ios/",
    "android/",
    "node_modules/"
  ],
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  }
}
