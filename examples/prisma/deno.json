{
  "nodeModulesDir": "manual",
  "links": ["./patch/better-sqlite3"],
  "tasks": {
    "setup": "deno run -A scripts/setup.ts",
    "dev": "deno run -A ../../cli.ts dev .",
    "build": "deno run -A ../../cli.ts build .",
    "start": "deno run -A ../../cli.ts start ."
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "denext",
    "lib": ["deno.window", "deno.unstable", "dom", "dom.iterable", "dom.asynciterable"]
  },
  "imports": {
    "denext": "../../mod.ts",
    "denext/jsx-runtime": "../../src/jsx/jsx-runtime.ts",
    "denext/jsx-dev-runtime": "../../src/jsx/jsx-runtime.ts",
    "denext/server": "../../src/server/mod.ts",
    "denext/client": "../../src/client/mod.ts",
    "denext/live": "../../src/live.ts",
    "@prisma/client": "npm:@prisma/client@^6.7.0",
    "@prisma/adapter-better-sqlite3": "npm:@prisma/adapter-better-sqlite3@^6.7.0"
  },
  "lint": {
    "plugins": ["../../src/lint/denext-plugin.ts"],
    "exclude": ["generated/"]
  },
  "fmt": {
    "exclude": ["generated/"]
  }
}
