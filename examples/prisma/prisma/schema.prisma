// The `prisma-client` generator emits an ESM, Deno-runtime client. The `queryCompiler` +
// `driverAdapters` preview features select the Rust-free query compiler — no native query
// engine binary — driven through the better-sqlite3 driver adapter, which (via deno.json
// `links`) talks to denext's node:sqlite compat. Without them the generator emits the
// library engine (a native `.node` binary that also rejects `{ adapter }` under Deno).
generator client {
  provider        = "prisma-client"
  output          = "../generated/client"
  runtime         = "deno"
  moduleFormat    = "esm"
  previewFeatures = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
}
