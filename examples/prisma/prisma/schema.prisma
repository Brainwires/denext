// The `prisma-client` generator emits an ESM, Deno-runtime client. Prisma 7 runs the
// Rust-free query compiler through a driver adapter by default (no native query engine, no
// preview features): here the better-sqlite3 adapter, which (via deno.json `links`) talks to
// denext's node:sqlite compat. The datasource URL the CLI uses lives in `prisma.config.ts`.
generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  runtime      = "deno"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())
}
