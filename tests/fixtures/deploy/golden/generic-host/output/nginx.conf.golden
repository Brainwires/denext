# Generated by `denext deploy` (generic-host). Regenerated by every `denext deploy prepare`;
# delete this line to keep your edits.
#
# Include in nginx's http block (e.g. /etc/nginx/conf.d/shop.conf), then add TLS (certbot).
limit_conn_zone $binary_remote_addr zone=shop_conn:10m;

# WebSocket upgrades (Live) get "Connection: upgrade"; everything else keeps the upstream alive.
map $http_upgrade $shop_connection {
  default upgrade;
  "" "";
}

upstream shop {
  server 127.0.0.1:3000;
  keepalive 32;
}

server {
  listen 80;
  server_name shop.example.com;

  # The concurrency ceiling denext expects in front of it (https://denext.dev/docs/deploy).
  limit_conn shop_conn 100;
  client_max_body_size 10m;

  # Content-hashed files under /_denext/client/ already carry an immutable
  # Cache-Control from denext, so a CDN in front of this caches them for a year.
  location / {
    proxy_pass http://shop;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Overwrite, never append: the server trusts this header (DENEXT_TRUST_PROXY=1 in the
    # unit), so a client's own X-Forwarded-For must not reach it.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Live (WebSocket) and streamed responses.
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $shop_connection;
    proxy_buffering off;
    proxy_read_timeout 1h;
  }
}
