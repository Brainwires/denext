# Generated by `denext deploy` (generic-host). Regenerated by every `denext deploy prepare`;
# delete this line to keep your edits.
#
# Install: copy to /etc/systemd/system/shop.service, put the variables from env.example in
# /etc/shop/env (mode 600), then `systemctl daemon-reload && systemctl enable --now shop`.
# Deploy: put the new release in /srv/shop, run build.sh there as shop (unless it is a
# compiled build), then `systemctl restart shop` (SIGTERM drains in-flight requests).
# build.sh resolves every dependency and denext's Deno toolchain into DENO_DIR below, so the
# sandboxed server (ProtectHome, a read-only system) loads them without the network or a home.
[Unit]
Description=shop (denext)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shop
WorkingDirectory=/srv/shop
Environment=PORT=443
Environment=DENO_DIR=/srv/shop/.deno
Environment=DENEXT_CANONICAL_ORIGIN=https://shop.example.com
Environment=DENEXT_LOG=json
# start.tls: the server serves HTTPS itself on port 443, every interface, with no proxy in
# front, so it trusts no X-Forwarded-* header. The env file's variables name the PEM files:
#   SHOP_CERT SHOP_KEY DEFAULT_CERT DEFAULT_KEY
# and shop must be able to read them (ProtectHome hides /home). For a root-only key, let
# systemd hand it over instead: `LoadCredential=key:/etc/ssl/private/site.pem` and
# `Environment=SHOP_KEY=%d/key` here, with that variable left out of the env file (whose values
# win over Environment=).
# Port 443 is privileged: let the unprivileged service user bind it, and nothing more.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Hand the memory a load burst leaves behind back to the OS once the server goes idle (a full
# GC, then malloc_trim). DENO_UNSTABLE_IDLE_TRIM=0 in the env file below turns it off.
Environment=DENO_UNSTABLE_IDLE_TRIM=1
EnvironmentFile=-/etc/shop/env
ExecStart=/srv/shop/.deno/bin/deno run --allow-net-connect --allow-net-listen=:443,[::]:443 --allow-read --allow-env --allow-write=.denext jsr:@denext/denext@^4.1.0/cli start .
Restart=always
RestartSec=2
KillSignal=SIGTERM
# The drain, and systemd's stop timeout above it (the drain plus 20 s for the services, the plugin
# teardowns and onShutdown). Change both with the preset's drainMs (or DENEXT_SHUTDOWN_DRAIN_MS
# when `denext deploy prepare` runs), not in the env file: systemd would still stop at the old time.
Environment=DENEXT_SHUTDOWN_DRAIN_MS=10000
TimeoutStopSec=30
# Sandboxing: the server writes only its build directory (the durable cache, job history).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/shop/.denext

[Install]
WantedBy=multi-user.target
