#!/bin/sh
# Generated by `denext deploy` (generic-host). Regenerated by every `denext deploy prepare`;
# delete this line to keep your edits.
#
# Build a release in /srv/shop as the service user, then restart the unit:
#   sudo -u shop sh build.sh && sudo systemctl restart shop
# Needs a `deno` on PATH (any version: the build runs on denext's Deno toolchain).
set -eu
cd /srv/shop
export DENO_DIR=/srv/shop/.deno
deno install
deno task build
# The server runs on the toolchain the build used (Deno.SQL / postgresClient() included).
mkdir -p "$DENO_DIR/bin"
ln -sf "$(deno run -A 'jsr:@denext/denext@^4.1.0/cli' toolchain path)" "/srv/shop/.deno/bin/deno"
