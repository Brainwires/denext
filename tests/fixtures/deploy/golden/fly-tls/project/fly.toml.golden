# Generated by `denext deploy` (fly). Regenerated by every `denext deploy prepare`;
# delete this line to keep your edits.
app = "my-app"
primary_region = "ams"
kill_signal = "SIGTERM"
kill_timeout = "30s"

# Secrets the app needs — set them with `fly secrets set NAME=value`:
#   DATABASE_URL

[build]
  dockerfile = "Dockerfile"

[env]
  PORT = "3000"
  DENEXT_LOG = "json"
  DENEXT_SHUTDOWN_DRAIN_MS = "10000"

# start.tls: the server serves HTTPS itself, so Fly passes TLS through untouched (raw TCP). Put
# the PEM files on the machine (a [[files]] entry from a secret, or a volume) and set
# SHOP_CERT, SHOP_KEY, DEFAULT_CERT, DEFAULT_KEY to their paths.
[[services]]
  protocol = "tcp"
  internal_port = 3000
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

  [[services.ports]]
    port = 443

  [[services.tcp_checks]]
    grace_period = "15s"
    interval = "15s"
    timeout = "3s"

[[vm]]
  memory = "512mb"
