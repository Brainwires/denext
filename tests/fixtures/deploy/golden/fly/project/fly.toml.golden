# Generated by `denext deploy` (fly). Regenerated by every `denext deploy prepare`;
# delete this line to keep your edits.
app = "my-app"
primary_region = "ams"
kill_signal = "SIGTERM"
kill_timeout = "30s"

# Secrets the app needs — set them with `fly secrets set NAME=value`:
#   DATABASE_URL

[build]
  dockerfile = "Dockerfile"

[env]
  PORT = "3000"
  DENEXT_LOG = "json"
  DENEXT_SHUTDOWN_DRAIN_MS = "10000"

[http_service]
  internal_port = 3000
  force_https = true
  # Jobs or services run in the server: keep a machine running.
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

  [[http_service.checks]]
    grace_period = "15s"
    interval = "15s"
    method = "GET"
    path = "/_denext/health"
    timeout = "3s"

[[vm]]
  memory = "512mb"
