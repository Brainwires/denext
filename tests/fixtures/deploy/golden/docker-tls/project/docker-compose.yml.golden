# Generated by `denext generate docker`.
services:
  web:
    build: .
    ports:
      - "3000:3000"
    # start.tls: the certificate and key files, read-only (never baked into the image).
    volumes:
      - ./certs:/certs:ro
    environment:
      - NODE_ENV=production
      - SHOP_CERT=${SHOP_CERT:?set it in .env (see .env.example)}
      - SHOP_KEY=${SHOP_KEY:?set it in .env (see .env.example)}
      - DEFAULT_CERT=${DEFAULT_CERT:?set it in .env (see .env.example)}
      - DEFAULT_KEY=${DEFAULT_KEY:?set it in .env (see .env.example)}
    restart: unless-stopped
    # SIGTERM drains in-flight requests (DENEXT_SHUTDOWN_DRAIN_MS, 10 s by default) first.
    stop_grace_period: 30s
    # start.tls's variables (and anything else the app reads) come from .env (see .env.example).
    env_file:
      - path: .env
        required: false

  # Example Postgres service — uncomment, then wire DATABASE_URL into `web`
  # (or regenerate with `denext generate docker --postgres` for the full wiring).
  # db:
  #   image: postgres:17-alpine
  #   restart: unless-stopped
  #   environment:
  #     POSTGRES_USER: denext
  #     POSTGRES_PASSWORD: denext
  #     POSTGRES_DB: denext
  #   volumes:
  #     - denext-db:/var/lib/postgresql/data
  #   ports:
  #     - "127.0.0.1:5432:5432"

