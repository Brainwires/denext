# Generated by `denext generate docker`.
# Copy to .env and replace every placeholder:  cp .env.example .env
# .env holds real secrets: keep it out of git (add `.env` to .gitignore) — .dockerignore
# already keeps it out of the image. docker compose reads it for every service.

# Postgres superuser the database is created with. Only the db-init service (which creates the
# app's role) and the database's health check use it — the app and the migrations connect as
# POSTGRES_APP_USER.
POSTGRES_USER=denext

# The superuser's password. Postgres keeps the one the data volume was created with: editing it
# here later locks the stack out: change it with denext stack passwd --postgres, which updates
# the database first. Required.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# The app's own login role: owner of the database (it creates the backend's tables and the anon
# / authenticated roles), never a superuser. db-init creates it on every start.
POSTGRES_APP_USER=denext_app

# The app role's password (hex keeps it URL-safe inside DATABASE_URL); db-init sets it on every
# start, so changing it here takes effect on the next up. Required.
# Generate: openssl rand -hex 24
POSTGRES_APP_PASSWORD=

# The database name.
POSTGRES_DB=denext

# denextAuth's session and token secret (≥ 32 characters). Required.
# Generate: openssl rand -base64 32
AUTH_SECRET=

# The secret Server Action ids are salted with (at least 16 characters; openssl rand -base64
# 32). Set it at build time and at runtime, the same value on every instance: the build's secret
# is the one the client bundle carries ids for, so a value present only at runtime is ignored.
# Needed only when the image is built more than once (one build per host or region); one image
# shared by every instance carries the secret its build generated, so leave it empty then.
DENEXT_ACTION_ID_SECRET=

# Opt-in crash reports: when the server's Deno panics it sends one JSON report here — an
# https:// endpoint, or a file:///absolute/path.jsonl inside the container. http:// is refused.
# Read when the process starts, never baked into the image; it often carries an ingest token.
# Check it with denext crash-report test. Empty: off.
DENEXT_CRASH_REPORT_URL=

# @denext/backend supabase: the publishable (anon) API key, sb_publishable_….
# Generate: denext backend keys
DENEXT_PUBLISHABLE_KEY=

# @denext/backend supabase: the secret (service_role) API key, sb_secret_… — never ship it to a
# browser.
# Generate: denext backend keys
DENEXT_SECRET_KEY=

# @denext/backend supabase: ES256 private JWK(s) signing access tokens, as JSON (current first).
# Generate: denext backend keys
DENEXT_JWT_SIGNING_KEYS=

# @denext/backend supabase (legacy): verifies HS256 anon / service_role JWT keys (≥ 32
# characters).
# Generate: denext backend keys --legacy
DENEXT_JWT_SECRET=

# @denext/backend supabase: the SMTP server /auth/v1 sends its emails through when neither
# hooks.sendEmail nor sendVerificationRequest is configured (Supabase Auth's setting). TLS is
# required: port 465 is implicit TLS, any other port must offer STARTTLS.
GOTRUE_SMTP_HOST=

# The SMTP port: 587 (STARTTLS) or 465 (implicit TLS).
GOTRUE_SMTP_PORT=587

# The SMTP user (AUTH PLAIN / LOGIN).
GOTRUE_SMTP_USER=

# The SMTP password.
GOTRUE_SMTP_PASS=

# The sender address of /auth/v1's emails (needed with GOTRUE_SMTP_HOST).
GOTRUE_SMTP_ADMIN_EMAIL=

# The sender's display name.
GOTRUE_SMTP_SENDER_NAME=

# @denext/backend: encrypts the vault's secrets in Postgres (AES-256-GCM, ≥ 32 characters).
# Required.
# Generate: openssl rand -base64 32
DENEXT_VAULT_KEY=

# @denext/backend database webhooks: signs each delivery (Standard Webhooks). Optional: only
# read when backend({ webhooks }) is configured.
# Generate: openssl rand -base64 32
DENEXT_WEBHOOK_SECRET=

# @denext/backend storage: signs upload tokens and signed URLs (≥ 32 characters). Required.
# Generate: openssl rand -base64 32
DENEXT_STORAGE_SECRET=

# MinIO's root user — also the app's S3 access key.
MINIO_ROOT_USER=denext

# MinIO's root password — also the app's S3 secret key (≥ 8 characters). Required.
# Generate: openssl rand -hex 24
MINIO_ROOT_PASSWORD=

# The S3 bucket the bootstrap creates and the app stores objects in.
S3_BUCKET=media

# The S3 endpoint the app's own requests go to (inside the compose network).
S3_ENDPOINT=http://minio:9000

# Keep the per-IP limits (sign-in, sign-up and code budgets) on inside Docker, where clients
# arrive from a private bridge address that would otherwise skip them. Behind a reverse proxy
# also set DENEXT_TRUST_PROXY=1 (or DENEXT_RATE_LIMIT_TRUSTED_PROXIES) so each client gets its
# own budget instead of sharing the proxy's.
DENEXT_RATE_LIMIT_LOCAL_ADDRESSES=1

# The database dashboard's password (12 characters or more): sign in at http://127.0.0.1:3100
# (DASHBOARD_PORT moves it). Without one the dashboard stays locked. Change it with denext stack
# passwd --dashboard.
# Generate: openssl rand -hex 24
DASHBOARD_PASSWORD=

# The S3 endpoint BROWSERS reach the store at: presigned upload and download URLs are signed for
# this host. In production a public HTTPS hostname routed to the minio service; the default,
# http://localhost:9000, is the MinIO port this stack publishes on the machine's loopback
# (MINIO_PORT moves it — change both together).
S3_PUBLIC_ENDPOINT=http://localhost:9000
