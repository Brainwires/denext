# Generated by `denext generate docker`.
# Copy to .env and replace every placeholder:  cp .env.example .env
# .env holds real secrets: keep it out of git (add `.env` to .gitignore) — .dockerignore
# already keeps it out of the image. docker compose reads it for every service.

# Postgres superuser the database is created with.
POSTGRES_USER=denext

# Postgres password (hex keeps it URL-safe inside DATABASE_URL). Required.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# The database name.
POSTGRES_DB=denext

# denextAuth's session and token secret (≥ 32 characters). Required.
# Generate: openssl rand -base64 32
AUTH_SECRET=

# @denext/backend: signs the API keys and access tokens (HS256). Required.
# Generate: openssl rand -base64 32
DENEXT_JWT_SECRET=

# @denext/backend: encrypts the vault's secrets in Postgres. Required.
# Generate: openssl rand -base64 32
DENEXT_VAULT_KEY=

# @denext/backend storage: signs upload tokens and signed URLs (≥ 32 characters). Required.
# Generate: openssl rand -base64 32
DENEXT_STORAGE_SECRET=

# MinIO's root user — also the app's S3 access key.
MINIO_ROOT_USER=denext

# MinIO's root password — also the app's S3 secret key (≥ 8 characters). Required.
# Generate: openssl rand -hex 24
MINIO_ROOT_PASSWORD=

# The S3 bucket the bootstrap creates and the app stores objects in.
S3_BUCKET=denext

# The S3 endpoint the app signs requests and presigned URLs for. Browsers upload and download
# through those URLs, so in production make it a public HTTPS hostname routed to the minio
# service (reachable from the app container too).
S3_ENDPOINT=http://minio:9000
