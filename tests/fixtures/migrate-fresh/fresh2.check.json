  "wontMigrate": [
    {
      "item": "vite.config.ts: inspect()",
      "reason": "a Vite plugin; denext builds the app without Vite. Port what it does (a build step, an emitted file) to denext.config.ts (`plugins`, `viteEmitterPlugin`)"
    }
  ],
  "review": [
    {
      "item": "routes/lang/[[lang]].tsx",
      "reason": "its URL pattern /lang{/:lang}? has no app/ folder equivalent: middleware.ts rewrites matching requests to the page generated for it"
    },
    {
      "item": "routes/raw.ts",
      "reason": "its URL pattern /@:version/:path* has no app/ folder equivalent: middleware.ts answers it with the route's handler"
    },
    {
      "item": "import.meta.env",
      "reason": "rewritten to importMetaEnv from denext/fresh/env (MODE, DEV, PROD, SSR, BASE_URL and the FRESH_PUBLIC_* / DENEXT_PUBLIC_* / NEXT_PUBLIC_* variables; server-only variables are not in it: read Deno.env). PROD is true under `denext start`, where your source runs in place, not from Vite's build output: check code that picks a file path by it (components/Env.tsx)"
    }
  ],
